# REQUIRED: private website credentials. Never commit .env.
PROJECT1_PASSWORD=replace-with-strong-private-password
PROJECT1_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
# Optional, source project data branch
BOMBIM_DATA_BRANCH=runtime-live
PORT=3001
NODE_ENV=production

# Optional US PostHog project token for aggregate menu counts
POSTHOG_PROJECT_TOKEN=
