# Primary historical archive endpoint (Cloudflare Worker with D1).
PROJECT1_HISTORY_API=
# Guide input collector endpoint (separate Cloudflare Worker).
PROJECT1_GUIDE_API=
# Direct source settings apply when the historical mirror is unset or unavailable.
# Optional, source project data branch
BOMBIM_DATA_BRANCH=runtime-live
# Optional secret: fine-grained GitHub token for Bombim00, Contents: read only.
BOMBIM_READ_TOKEN=
PORT=3001
NODE_ENV=production

# Optional US PostHog project token for aggregate menu counts
POSTHOG_PROJECT_TOKEN=
